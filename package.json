{
  "name": "byteback",
  "version": "0.1.0",
  "description": "Byteback - Professional Disk Data Recovery Application",
  "main": "./out/main/main.js",
  "scripts": {
    "build:native": "cmake-js compile -d native -O native/build --runtime electron --runtime-version 44.2.0 --arch x64",
    "dev": "npm run build:native && electron-vite dev",
    "build": "npm run build:native && electron-vite build",
    "preview": "electron-vite preview",
    "start": "npm run dev",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "audit:prod": "npm audit --omit=dev",
    "verify:audit": "npm run audit:prod && npm audit && npm run typecheck && npm test",
    "verify:audit:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-audit-roadmap.ps1",
    "release:dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-dist.ps1",
    "release:dist:unsigned": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-dist.ps1 -AllowUnsigned",
    "field:usb:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/field-usb-preflight.ps1",
    "phase4:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/phase4-status.ps1",
    "verify:goal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-goal-closure.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native": "cmake -S native -B native/build -DBYTEBACK_BUILD_TESTS=ON && cmake --build native/build --config Release --target byteback_tests && ctest --test-dir native/build -C Release --output-on-failure",
    "test:e2e": "playwright test",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "node-addon-api": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "cmake-js": "^8.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.byteback.app",
    "productName": "Byteback",
    "copyright": "MIT License",
    "icon": "resources/icon.png",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "native/build/Release/**",
      "resources/signatures-extended.json",
      "resources/signatures-supplement.json"
    ],
    "files": [
      "out/**/*",
      "native/build/Release/byteback_engine.node",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Byteback",
      "perMachine": true
    }
  },
  "author": "Batuhan Yuksel"
}
