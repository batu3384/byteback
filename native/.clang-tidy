# Byteback — C++ static analysis policy
# Run with:
#   clang-tidy -p native/build <file>   (needs compile_commands.json)
# Generate compile_commands.json by configuring CMake with:
#   cmake -S native -B native/build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
#
# Tuned to the existing codebase: Windows-first, C++17, header-heavy, N-API.
# We start from a curated (not Google-everything) checks list so the policy is
# actionable rather than noisy, then tighten over time.

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  cert-*,
  -cert-err58-cpp,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-pro-type-static-cast-downcast,
  cppcoreguidelines-slicing,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  performance-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-else-after-return

# Treat the check list as strict (anything not listed is off).
WarningsAsErrors: ''

CheckOptions:
  - key:   readability-identifier-naming.NamespaceCase
    value: lower_case
  - key:   readability-identifier-naming.ClassCase
    value: CamelCase
  - key:   readability-identifier-naming.StructCase
    value: CamelCase
  - key:   readability-identifier-naming.FunctionCase
    value: lower_case
  - key:   readability-identifier-naming.ParameterCase
    value: lower_case
  - key:   readability-identifier-naming.VariableCase
    value: lower_case
  - key:   readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key:   readability-identifier-naming.ConstantCase
    value: UPPER_CASE
  - key:   modernize-use-override.IgnoreDestructors
    value: '1'
  - key:   performance-unnecessary-value-param.AllowedTypes
    value: 'std::atomic_flag;std::function'

# Allow the vendored third-party SQLite amalgamation and the N-API header
# shims to bypass analysis — they are not ours to reformat.
HeaderFilterRegex: '^(?!.*(third_party|node-addon-api|sqlite3)).*$'
