# Copy to the release machine as release-sign.env (never commit secrets).
# electron-builder signs when CSC_LINK is set: https://www.electron.build/code-signing

# Path to .pfx or base64 blob
# CSC_LINK=C:\secrets\byteback-sign.pfx
# CSC_KEY_PASSWORD=

# Optional: Azure Trusted Signing / custom signtool
# WIN_CSC_LINK=
# WIN_CSC_KEY_PASSWORD=

# After env is loaded (PowerShell):
#   $env:CSC_LINK = 'C:\secrets\byteback-sign.pfx'
#   $env:CSC_KEY_PASSWORD = '...'
#   powershell -File scripts/release-dist.ps1
#
# Or GitHub Actions: workflow "Release (signed, manual)" with secrets CSC_LINK + CSC_KEY_PASSWORD.
# Verify: signtool verify /pa release\*.exe
