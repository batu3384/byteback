{
  "name": "wolf-recovery",
  "version": "0.1.0",
  "description": "Wolf Recovery — Professional Disk Data Recovery Application",
  "main": "./out/main/main.js",
  "scripts": {
    "build:native": "cmake-js compile -d native -O native/build --runtime electron --runtime-version 31.0.0 --arch x64",
    "dev": "npm run build:native && electron-vite dev",
    "build": "npm run build:native && electron-vite build",
    "preview": "electron-vite preview",
    "start": "npm run dev",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native": "cmake --build native/build --config Release --target wolf_tests && ctest --test-dir native/build -C Release --output-on-failure",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "node-addon-api": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cmake-js": "^8.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.wolf.recovery",
    "productName": "Wolf Recovery",
    "copyright": "MIT License",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "native/build/Release/**"
    ],
    "files": [
      "out/**/*",
      "native/build/Release/wolf_engine.node",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Wolf Recovery"
    }
  }
}
