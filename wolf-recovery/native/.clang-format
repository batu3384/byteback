# Wolf Recovery — C++ formatting policy
# Based on Google style, tuned for the MSVC/cmake-js toolchain. Run with:
#   clang-format -i <file>
# or apply to staged changes only:
#   git clang-format
BasedOnStyle: Google

# Language & standard
Language: Cpp
Standard: c++17

# Indentation: 4 spaces (matches the existing codebase)
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4

# Line length — keep tight for side-by-side review; matches Google default
ColumnLimit: 110

# Braces: same-line opening (K&R / Attach), matches existing code
BreakBeforeBraces: Attach

# Pointers/reference cling to the type name (wolf:: style: const T& foo)
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left

# Includes: keep simple block sorting; third-party vendored (sqlite3.h)
# is handled by the include guard, not by sorting.
IncludeBlocks: Preserve
SortIncludes: CaseSensitive

# Allow short functions/if/loops on a single line only when truly trivial
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty

# Arguments and templates
AlignAfterOpenBracket: Align
BinPackArguments: false
BinPackParameters: false
AllowAllArgumentsOnNextLine: true

# Spacing
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpacesInContainerLiterals: false

# Trailing comments: keep two spaces before them
SpacesBeforeTrailingComments: 2

# Namespace indentation: do NOT indent inside namespace wolf { } — matches
# the existing flat layout.
NamespaceIndentation: None

# Miscellaneous
FixNamespaceComments: true
ReflowComments: true
SortUsingDeclarations: true
